{
  "name": "joylab-cs-adaptive-learning",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "analyze:gold": "tsx src/run-gold.ts",
